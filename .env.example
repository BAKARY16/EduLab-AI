# Authentification : "local" pour PostgreSQL seul, "supabase" pour Supabase Auth
AUTH_PROVIDER=local
SESSION_SECRET=replace-with-at-least-32-random-characters

# Connexion PostgreSQL. Dans Supabase : Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/edulab

# Requis uniquement lorsque AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# IA : l'application reste explicitement en démonstration sans clé
LLM_PROVIDER=hybrid
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
TEACHER_MODEL_URL=http://127.0.0.1:8010
TEACHER_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
TEACHER_ADAPTER_PATH=models/edulab-teacher-qwen-0.5b-lora
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_URL=http://127.0.0.1:8000/api/v1
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=20

# Voix : fournisseur "elevenlabs" ou "browser" (repli navigateur).
# Le backend (apps/api) est seul détenteur des clés ; jamais exposées au frontend.
TTS_PROVIDER=browser
STT_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
# Optionnel : clé distincte pour le STT si ses permissions diffèrent de celles du TTS.
ELEVENLABS_STT_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
VOICE_CACHE_ENABLED=true
REALTIME_VOICE_PROVIDER=pipeline

# Recherche web contrôlée (WebResearchAgent), limitée aux domaines autorisés
# (voir services/agents/web_research.py) — repli quand le RAG local est insuffisant.
SERPAPI_API_KEY=
